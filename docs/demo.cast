{"version": 2, "width": 120, "height": 35, "timestamp": 1792758724, "title": "primitive-db — локальное демо", "env": {"TERM": "xterm-256color", "SHELL": "/bin/sh"}}
[0.116171, "o", "Демонстрация на временной базе. Команды выполняются программой.\r\n"]
[0.116207, "o", "\r\n"]
[0.116209, "o", "> create_table users name:str age:int active:bool\r\n"]
[0.116931, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, active:bool\r\n"]
[0.116934, "o", "\r\n"]
[0.116935, "o", "> list_tables\r\n"]
[0.117087, "o", "- users\r\n"]
[0.117092, "o", "\r\n"]
[0.117093, "o", "> insert into users values (\"Anna Maria\", 28, true)\r\n"]
[0.117296, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[0.117508, "o", "Запись с ID=1 добавлена в \"users\".\r\n"]
[0.117514, "o", "\r\n"]
