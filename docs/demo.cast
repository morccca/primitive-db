{"version": 2, "width": 110, "height": 30, "title": "primitive-db"}
[0.0, "o", "\u001b[2J\u001b[HДемонстрация на временной базе. Команды выполняются программой.\r\nПримитивная база данных. help — справка, exit — выход.\r\n"]
[4.0, "o", "\u001b[2J\u001b[H> create_table users name:str age:int active:bool\r\nТаблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, active:bool\r\n"]
[8.0, "o", "\u001b[2J\u001b[H> list_tables\r\n- users\r\n"]
[12.0, "o", "\u001b[2J\u001b[H> insert into users values (\"Anna Maria\", 28, true)\r\nФункция insert выполнилась за 0.000 секунд\r\nЗапись с ID=1 добавлена в \"users\".\r\n"]
[16.0, "o", "\u001b[2J\u001b[H> select from users\r\nФункция select выполнилась за 0.000 секунд\r\n+----+------------+-----+--------+\r\n| ID |    name    | age | active |\r\n+----+------------+-----+--------+\r\n| 1  | Anna Maria |  28 |  True  |\r\n+----+------------+-----+--------+\r\n"]
[20.0, "o", "\u001b[2J\u001b[H> update users set age=29 where name=\"Anna Maria\"\r\nОперация update выполнена. Записей: 1\r\n"]
[24.0, "o", "\u001b[2J\u001b[H> select from users where age=29\r\nФункция select выполнилась за 0.000 секунд\r\n+----+------------+-----+--------+\r\n| ID |    name    | age | active |\r\n+----+------------+-----+--------+\r\n| 1  | Anna Maria |  29 |  True  |\r\n+----+------------+-----+--------+\r\n"]
[28.0, "o", "\u001b[2J\u001b[H> info users\r\nТаблица: users\r\nСтолбцы: ID:int, name:str, age:int, active:bool\r\nКоличество записей: 1\r\n"]
[32.0, "o", "\u001b[2J\u001b[H> insert into users values (\"Wrong\", \"not an integer\", true)\r\nФункция insert выполнилась за 0.000 секунд\r\nОшибка валидации: Столбец age ожидает int\r\n"]
[36.0, "o", "\u001b[2J\u001b[H> delete from users where ID=1\r\nВы уверены, что хотите выполнить \"удаление записей\"? [y/n]: y\r\nОперация delete выполнена. Записей: 1\r\n"]
[40.0, "o", "\u001b[2J\u001b[H> select from users\r\nФункция select выполнилась за 0.000 секунд\r\n+----+------+-----+--------+\r\n| ID | name | age | active |\r\n+----+------+-----+--------+\r\n+----+------+-----+--------+\r\n"]
[44.0, "o", "\u001b[2J\u001b[H> drop_table users\r\nВы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: y\r\nТаблица \"users\" успешно удалена.\r\n"]
[48.0, "o", "\u001b[2J\u001b[H> list_tables\r\nТаблиц нет\r\n"]
[52.0, "o", "\u001b[2J\u001b[H> exit\r\n"]
